# Copy to .env.local and fill in from your Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key. NEVER the secret key —
# NEXT_PUBLIC_ values are shipped to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only (never expose to the browser). Used by edge functions / admin tasks.
# Secret key (sb_secret_...) or legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Email (Phase 3 — Resend). Optional until you wire notifications.
RESEND_API_KEY=
# Secret used to sign reply-by-email addresses
INBOUND_EMAIL_HMAC_SECRET=change-me
